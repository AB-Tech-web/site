{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins/' + auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins/' + auth.uid).val() === true"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins/' + auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['email'])"
      }
    },
    "deleted": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins/' + auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins/' + auth.uid).val() === true"
      }
    },
    "projects": {
      ".read": true,
      "$id": { ".write": "auth != null && root.child('admins/' + auth.uid).val() === true" }
    },
    "requests": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$id": { ".write": "auth != null && ((auth.uid == $uid && !data.exists()) || root.child('admins/' + auth.uid).val() === true)" }
      }
    },
    "threads": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "meta": { ".write": "auth != null && (auth.uid == $uid || root.child('admins/' + auth.uid).val() === true)" },
        "msgs": {
          "$id": {
            ".write": "auth != null && ((auth.uid == $uid && !data.exists() && newData.child('from').val() == 'user') || root.child('admins/' + auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['from','text','t']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
          }
        }
      }
    },
    "inbox": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins/' + auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name','email','text','t']) && newData.child('text').val().length <= 3000 && newData.child('name').val().length <= 120 && newData.child('email').val().length <= 160"
      }
    },
    "site": {
      ".read": true,
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true"
    },
    "stats": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "total": { "$k": { ".write": "(!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1" } },
      "days": { "$d": { "$k": { ".write": "(!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1" } } }
    },
    "settings": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true"
    },
    "adminCodes": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && root.child('admins/' + auth.uid).val() === true",
        ".write": "auth != null && auth.uid == $uid && root.child('admins/' + auth.uid).val() === true"
      }
    }
  }
}
